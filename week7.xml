        <subsection environment="" chapter_type="" type="Section" wbtag="subsection" title="Definition of a Ring" course="Math 2078" chapter="7" section="1" num="1" serial="7.1.1">
          <title environment="title" chapter_type="Week" wbtag="title" scope="subsection" course="Math 2078" chapter="7" section="1" subsection="" subsubsection="" serial="7.1.1" slide="">
            <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="" subsubsection="" environment="title" wbtag="paragraphs">Definition of a Ring</paragraphs>
          </title>
          <slides environment="" chapter_type="">
            <slide environment="" chapter_type="Week" canon_num="4" scope="subsection" id="s4" slide="4" course="Math 2078" chapter="7" section="1" subsection="1" subsubsection="" chapter_title="" section_title="Rings">
              <keywords slide="4" environ="slide" chapter="7" course="Math 2078">
                <keyword chapter="7" slide="4">ring</keyword>
                <keyword chapter="7" slide="4">additive identity element</keyword>
                <keyword chapter="7" slide="4">multiplicative identity element</keyword>
              </keywords>
              <title environment="title" chapter_type="Week" wbtag="title" scope="subsection" course="Math 2078" chapter="7" section="1" subsection="1" subsubsection="" serial="" slide="4">
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="title" wbtag="paragraphs">Definition of a Ring</paragraphs>
              </title>
              <statement environment="statement" chapter_type="Week" type="Definition" wbtag="defn" num="1" md5="0a206b94603b3aa73ff196bc390ebe06" course="Math 2078" chapter="7" slide="4" item="7.1">
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs"> A </paragraphs>
                <inline_keyword course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement">ring</inline_keyword>
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs"> $R$ (or $(R, +, \times)$) is a set equipped with two operations:
\[
\times, + : R\times R \rightarrow R
\]
which satisfy the following properties: </paragraphs>
                <ol xmlns="http://www.w3.org/1999/xhtml" environment="statement">
                  <li environment="statement">
                    <paragraphs xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs"> Properties of $+$: </paragraphs>
                    <col_ol xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_ol">
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> Commutativity: $a + b = b + a$, $\forall a, b \in R$. </paragraphs>
                      </col_li>
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> Associativity: $a + (b + c) = (a + b) + c$. </paragraphs>
                      </col_li>
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> There is an element $0 \in R$ (called the </paragraphs>
                        <inline_keyword course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol">additive identity element</inline_keyword>
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> ),
such that $a + 0 = a$ for all $a \in R$. </paragraphs>
                      </col_li>
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> Every element of $R$ has an additive inverse; namely:
For all $a \in R$, there exists an element of $R$, usually denoted $-a$,
such that $a + (-a) = 0$. </paragraphs>
                      </col_li>
                    </col_ol>
                  </li>
                  <li environment="statement">
                    <paragraphs xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs"> Properties of $\times$: </paragraphs>
                    <col_ol xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_ol">
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> Associativity: $a(bc) = (ab)c$. </paragraphs>
                      </col_li>
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> There is an element $1 \in R$ (called the </paragraphs>
                        <inline_keyword course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol">multiplicative identity element</inline_keyword>
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> ),
such that $1\times a = a\times 1 = a$ for all $a \in R$. </paragraphs>
                      </col_li>
                    </col_ol>
                  </li>
                  <li environment="statement">
                    <paragraphs xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs"> Distributativity: </paragraphs>
                    <col_ol xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_ol">
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $a\times(b + c) = a\times b + a\times c$, for all $a, b, c \in R$. </paragraphs>
                      </col_li>
                      <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $(a + b) \times c = a \times c + b\times c$, for all $a, b, c \in R$. </paragraphs>
                      </col_li>
                    </col_ol>
                  </li>
                </ol>
              </statement>
              <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment=""/>
              <strong xmlns="http://www.w3.org/1999/xhtml" environment="">
                <paragraphs xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="" wbtag="paragraphs">Note:</paragraphs>
              </strong>
              <newcol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="newcol">
                <col_ol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_ol">
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> For convenience's sake, we often write $ab$ for $a\times b$. </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> In the definition, commutativity is required of addition, but not of multiplication. </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> Every element has an additive inverse, but </paragraphs>
                    <i xmlns="http://www.w3.org/1999/xhtml" environment="col_ol">
                      <paragraphs xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> not necessarily</paragraphs>
                    </i>
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> a multiplicative inverse.
That is, there may be an element $a \in R$ such that $ab \neq 1$ for all $b \in R$. </paragraphs>
                  </col_li>
                </col_ol>
              </newcol>
            </slide>
            <slide environment="" chapter_type="Week" wbtag="slide" canon_num="5" id="s5" slide="5" course="Math 2078" chapter="7" section="1" subsection="1" subsubsection="" chapter_title="" section_title="Rings">
              <keywords slide="5" environ="slide" chapter="7" course="Math 2078"/>
              <statement environment="statement" chapter_type="Week" type="Example" wbtag="eg" num="2" md5="303020730acce82f67b8b05fe15b5e93" course="Math 2078" chapter="7" slide="5" item="7.2">
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs"> The following sets, equipped with the usual operations of addition and multiplication,
are rings: </paragraphs>
                <col_ol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_ol">
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $\mathbb{Z}$, $\mathbb{Q}$, $\mathbb{R}$ </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $\mathbb{Z}[x]$, $\mathbb{Q}[x]$, $\mathbb{R}[x]$
(Polynomials with integer, rational, real coefficients, respectively.) </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> \[
\begin{split}
\mathbb{Q}[\sqrt{2}] &amp;=
\{\sum_{k = 0}^n a_k(\sqrt{2})^k\, |\, a_k \in \mathbb{Q}, n \in \mathbb{Z}_{\geq 0}\}\\
&amp;= \{a + b\sqrt{2}\, |\, a, b \in \mathbb{Q}\}.
\end{split}
\] </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $M_n(\mathbb{R})$,
the set of $n \times n$ real matrices, $n \in \mathbb{N}$. </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> For a fixed $n$, the set of $n\times n$ matrices with integer coefficients. </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $C[0, 1] = \{f : [0, 1]\rightarrow \mathbb{R}\; |\; f \text{ is continuous.}\}$ </paragraphs>
                  </col_li>
                </col_ol>
                <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement"/>
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs">The following sets, under the usual operations of addition and multiplication, are not rings: </paragraphs>
                <col_ol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_ol">
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $\mathbb{N}$, no additive identity element, i.e. no 0. </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $\mathbb{N}\cup\{0\}$, nonzero elements have no additive inverses. </paragraphs>
                  </col_li>
                  <col_li course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="col_li">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="col_ol" wbtag="paragraphs"> $\GL(n, \mathbb{R})$,
the set of $n \times n$ invertible real matrices, $n \in \mathbb{N}$. </paragraphs>
                  </col_li>
                </col_ol>
              </statement>
            </slide>
            <slide environment="" chapter_type="Week" wbtag="slide" canon_num="6" id="s6" slide="6" course="Math 2078" chapter="7" section="1" subsection="1" subsubsection="" chapter_title="" section_title="Rings">
              <keywords slide="6" environ="slide" chapter="7" course="Math 2078"/>
              <statement environment="statement" chapter_type="Week" type="Claim" wbtag="claim" num="3" md5="3db3b3b565ba9ccf73513c010f0852a8" course="Math 2078" chapter="7" slide="6" item="7.3">
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="statement" wbtag="paragraphs"> In a ring $R$, there is a unique additive identity element
and a unique multiplicative identity element. </paragraphs>
              </statement>
              <substatement environment="substatement" chapter_type="Week" type="Proof" wbtag="proof" md5="7898e16c1a978cf07b406aeda181188e" course="Math 2078" chapter="7" slide="6" of="3db3b3b565ba9ccf73513c010f0852a8" of-src-course="Math 2078" of-src-chapter="7" of-src-slide="6" of-type="Claim" of-item="7.3" of-src-filename="week7.xml" ofmd5="3db3b3b565ba9ccf73513c010f0852a8" of-serial="">
                <of-title hidden="true">Claim 7.3</of-title>
                <newcol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="newcol">
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="paragraphs"> Suppose there is an element $0' \in R$ such that $0' + r = r$ for all $r \in R$, then
in particular $0' + 0 = 0$.</paragraphs>
                  <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol"/>
                  <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="collapse">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="paragraphs"> Since $0$ is an additive identity, we have $0' + 0 = 0'$.
So, $0' = 0$.</paragraphs>
                    <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol"/>
                    <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="collapse">
                      <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="paragraphs"> Suppose there is an element $1' \in R$ such that $1'r = r$ or all $r \in R$,</paragraphs>
                      <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol"/>
                      <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="collapse">
                        <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="paragraphs"> then in particular $1' \cdot 1 = 1$.</paragraphs>
                        <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol"/>
                        <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="collapse">
                          <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="paragraphs"> But $1' \cdot 1 = 1'$ since $1$ is a multiplicative identity element, so $1' = 1$. </paragraphs>
                          <qed course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol"/>
                        </collapse>
                      </collapse>
                    </collapse>
                  </collapse>
                </newcol>
              </substatement>
              <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment=""/>
              <statement environment="statement" chapter_type="Week" type="Exercise" wbtag="ex" num="4" md5="4362df2060aa5a9465ae569bbf3abfa1" course="Math 2078" chapter="7" slide="6" item="7.4">
                <newcol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="newcol">
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="1" subsubsection="" environment="newcol" wbtag="paragraphs"> Prove that:
For any $r$ in a ring $R$, its additive inverse $-r$ is unique.
That is, if $r + r' = r + r'' = 0$, then $r' = r''$. </paragraphs>
                </newcol>
              </statement>
            </slide>
          </slides>
        </subsection>
        <subsection environment="" chapter_type="" type="Section" wbtag="subsection" title="WeBWorK" course="Math 2078" chapter="7" section="1" num="2" serial="7.1.2">
          <title environment="title" chapter_type="Week" wbtag="title" scope="subsection" course="Math 2078" chapter="7" section="1" subsection="" subsubsection="" serial="7.1.2" slide="">
            <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="" subsubsection="" environment="title" wbtag="paragraphs">WeBWorK</paragraphs>
          </title>
          <slides environment="" chapter_type="">
            <slide environment="" chapter_type="Week" canon_num="7" scope="subsection" id="s7" slide="7" course="Math 2078" chapter="7" section="1" subsection="2" subsubsection="" chapter_title="" section_title="Rings">
              <keywords slide="7" environ="slide" chapter="7" course="Math 2078"/>
              <title environment="title" chapter_type="Week" wbtag="title" scope="subsection" course="Math 2078" chapter="7" section="1" subsection="2" subsubsection="" serial="" slide="7">
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="title" wbtag="paragraphs">WeBWorK</paragraphs>
              </title>
              <enumerate course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="enumerate" wbtag="enumerate">
