      <slides environment="" chapter_type="">
        <slide environment="" chapter_type="Week" canon_num="2" scope="week" id="s2" slide="2" course="Math 2078" chapter="10" section="" subsection="" subsubsection="" chapter_title="" section_title="">
          <title environment="title" chapter_type="Week" wbtag="week" scope="chapter" course="" chapter="" section="" subsection="" subsubsection="" serial="" slide="2"/>
          <keywords slide="2" environ="slide" chapter="10" course="Math 2078"/>
