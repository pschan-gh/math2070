            <slide environment="" chapter_type="Week" wbtag="slide" canon_num="8" id="s8" slide="8" course="Math 2078" chapter="7" section="1" subsection="2" subsubsection="" chapter_title="" section_title="Rings">
              <keywords slide="8" environ="slide" chapter="7" course="Math 2078"/>
              <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment=""/>
              <statement environment="statement" chapter_type="Week" type="Claim" wbtag="claim" num="5" md5="06c93e407cb78d275e72438b2177a1dd" course="Math 2078" chapter="7" slide="8" item="7.5">
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="statement" wbtag="paragraphs"> For all elements $r$ in a ring $R$, we have $0r = r0 = 0$. </paragraphs>
              </statement>
              <substatement environment="substatement" chapter_type="Week" type="Proof" wbtag="proof" md5="1f8a1cb45717ede2d17734b9c60b3784" course="Math 2078" chapter="7" slide="8" of="06c93e407cb78d275e72438b2177a1dd" of-src-course="Math 2078" of-src-chapter="7" of-src-slide="8" of-type="Claim" of-item="7.5" of-src-filename="week7.xml" ofmd5="06c93e407cb78d275e72438b2177a1dd" of-serial="">
                <of-title hidden="true">Claim 7.5</of-title>
                <newcol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="newcol">
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> By distributativity,
\[
0r = (0 + 0)r = 0r + 0r.
\] </paragraphs>
                  <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="collapse">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> Adding $-0r$ (additive inverse of $0r$) to both sides, we have:
\[
0 = (0r + 0r) + (-0r) = 0r + (0r + (-0r)) = 0r + 0 = 0r.
\]</paragraphs>
                    <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol"/>
                    <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="collapse">
                      <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> The proof of $r0 = 0$ is similar and we leave it as an </paragraphs>
                      <strong xmlns="http://www.w3.org/1999/xhtml" environment="newcol">
                        <paragraphs xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs">exercise</paragraphs>
                      </strong>
                      <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> . </paragraphs>
                      <qed course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol"/>
                    </collapse>
                  </collapse>
                </newcol>
              </substatement>
              <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment=""/>
              <statement environment="statement" chapter_type="Week" type="Claim" wbtag="claim" num="6" md5="ae67e49b63f437688b9241a878c3d85f" course="Math 2078" chapter="7" slide="8" item="7.6">
                <newcol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="newcol">
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> For all elements $r$ in a ring, we have $(-1)(-r) = (-r)(-1)= r$. </paragraphs>
                </newcol>
              </statement>
              <substatement environment="substatement" chapter_type="Week" type="Proof" wbtag="proof" md5="6fdd0fa7d2c0fb732519b938c066c8dd" course="Math 2078" chapter="7" slide="8" of="ae67e49b63f437688b9241a878c3d85f" of-src-course="Math 2078" of-src-chapter="7" of-src-slide="8" of-type="Claim" of-item="7.6" of-src-filename="week7.xml" ofmd5="ae67e49b63f437688b9241a878c3d85f" of-serial="">
                <of-title hidden="true">Claim 7.6</of-title>
                <newcol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="newcol">
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> We have:
\[
0 = 0(-r) = (1 + (-1))(-r) = -r + (-1)(-r).
\] </paragraphs>
                  <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="collapse">
                    <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> Adding $r$ to both sides, we obtain
\[
r = r + (-r + (-1)(-r)) = (r + -r) + (-1)(-r) = (-1)(-r).
\] </paragraphs>
                    <collapse course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="collapse">
                      <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> We leave it as an </paragraphs>
                      <strong xmlns="http://www.w3.org/1999/xhtml" environment="newcol">
                        <paragraphs xmlns="http://www.math.cuhk.edu.hk/~pschan/cranach" course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs">exercise</paragraphs>
                      </strong>
                      <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> to show that $(-r)(-1) = r$. </paragraphs>
                      <qed course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol"/>
                    </collapse>
                  </collapse>
                </newcol>
              </substatement>
              <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment=""/>
            </slide>
            <slide environment="" chapter_type="Week" wbtag="slide" canon_num="9" id="s9" slide="9" course="Math 2078" chapter="7" section="1" subsection="2" subsubsection="" chapter_title="" section_title="Rings">
              <keywords slide="9" environ="slide" chapter="7" course="Math 2078">
                <keyword chapter="7" slide="9">zero ring</keyword>
              </keywords>
              <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment=""/>
              <statement environment="statement" chapter_type="Week" type="Exercise" wbtag="ex" num="7" md5="97fcac3949c90d57ee7ba8b8f664bd28" course="Math 2078" chapter="7" slide="9" item="7.7">
                <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="statement" wbtag="paragraphs"> Show that:
For all $r$ in a ring $R$, we have:
\[
(-1) r = r(-1) = -r.
\] </paragraphs>
              </statement>
              <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment=""/>
              <statement environment="statement" chapter_type="Week" type="Exercise" wbtag="ex" num="8" md5="1c2e2ec38e571aff1c68a3aef3bbf546" course="Math 2078" chapter="7" slide="9" item="7.8">
                <newcol course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="newcol">
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> Show that:
If $R$ is a ring in which $1 = 0$, then $R = \{0\}$.  That is, it has only one element.</paragraphs>
                  <newline course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol"/>
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs">(We call such an $R$ the </paragraphs>
                  <inline_keyword course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol">zero ring</inline_keyword>
                  <paragraphs course="Math 2078" chapter="7" chapter_type="" section="1" subsection="2" subsubsection="" environment="newcol" wbtag="paragraphs"> .) </paragraphs>
                </newcol>
              </statement>
            </slide>
          </slides>
